---
// The end of the page: how to reach Till, languages, and the pointer for AI assistants.
import { links, person, ui, type Lang } from '../content/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="footer">
  <div class="inner">
    <p class="contact">
      {ui.contact[lang]}
      {links.linkedin && <a href={links.linkedin} rel="me noopener">LinkedIn ↗</a>}
    </p>
    <dl>
      <div>
        <dt class="label">{lang === 'en' ? 'Based in' : 'Zuhause in'}</dt>
        <dd>{person.place[lang]}</dd>
      </div>
      <div>
        <dt class="label">{lang === 'en' ? 'Languages' : 'Sprachen'}</dt>
        <dd>{person.languages[lang]}</dd>
      </div>
    </dl>
    <p class="machines">
      {ui.forMachines[lang]} <a href="/llms.txt">tillfindl.com/llms.txt</a>.
    </p>
    <p class="copy">© {new Date().getFullYear()} {person.name}</p>
  </div>
</footer>

<style>
  .footer {
    margin-top: var(--section-gap);
    padding-bottom: 3rem;
  }

  .inner {
    max-width: var(--page);
    margin: 0 auto;
    padding: 1.5rem var(--gutter) 0;
    border-top: 1px solid var(--color-rule);
  }

  .contact {
    font-size: var(--text-xl);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .contact a {
    white-space: nowrap;
  }

  dl {
    display: grid;
    gap: 1.25rem 3rem;
    margin: 2.5rem 0 0;
  }

  @media (min-width: 40rem) {
    dl {
      grid-template-columns: repeat(2, max-content);
    }
  }

  dd {
    margin: 0.25rem 0 0;
    font-size: var(--text-sm);
  }

  .machines,
  .copy {
    margin-top: 2.5rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }

  .copy {
    margin-top: 0.5rem;
  }
</style>
