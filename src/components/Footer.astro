---
// A quiet last line.
import { page, person, type Lang } from '../content/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer>
  <span>© {new Date().getFullYear()} {person.name}</span>
  <a href="/llms.txt">{page.footer.forMachines[lang]}</a>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
    margin-top: var(--section-gap);
    padding: 1.25rem 0 calc(2.5rem + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--border);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /* Kept for machines: the same colour as the ground, so people do not notice it. */
  a {
    color: var(--bg);
  }
</style>
