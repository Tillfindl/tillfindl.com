---
// A quiet last line.
import { page, person, type Lang } from '../content/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="footer">
  <span>© {new Date().getFullYear()} {person.name}</span>
  <a href="/llms.txt">{page.footer.forMachines[lang]}</a>
</footer>

<style>
  .footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.75rem 2rem;
    max-width: calc(var(--width) + 2 * var(--side));
    margin: 0 auto;
    padding: 2rem var(--side) calc(2rem + env(safe-area-inset-bottom, 0px));
    color: var(--dark-soft);
    font-size: var(--text-sm);
  }

  a {
    text-decoration: none;
  }

  a:hover {
    color: var(--dark-ink);
  }
</style>
