---
// A quiet last line.
import { page, person, type Lang } from '../content/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer>
  <span>© {new Date().getFullYear()} {person.name}</span>
  <a class="machines" href="/llms.txt">{page.footer.forMachines[lang]}</a>
  <a class="top" href="#top">{page.footer.top[lang]}</a>
</footer>

<style>
  footer {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--s-2) var(--s-8);
    margin-top: var(--section);
    padding: var(--s-6) 0 calc(var(--s-12) + env(safe-area-inset-bottom, 0px));
    border-top: 1px solid var(--line);
    color: var(--muted);
    font-size: var(--text-sm);
  }

  /*
   * Kept for machines: the same colour as the ground, so people do not notice it. It goes on a
   * line of its own at the end, so the copyright and "Back to top" share the first line.
   */
  .machines {
    flex-basis: 100%;
    order: 1;
    color: var(--bg);
  }

  .top {
    color: var(--ink);
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-underline-offset: 0.22em;
  }

  .top:hover {
    text-decoration-color: var(--ink);
  }
</style>
