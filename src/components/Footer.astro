---
// The end of the page: where Till is, his languages, and the pointer for AI assistants.
import { person, ui, type Lang } from '../content/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<footer class="footer">
  <dl>
    <div>
      <dt class="eyebrow">{ui.basedIn[lang]}</dt>
      <dd>{person.place[lang]}</dd>
    </div>
    <div>
      <dt class="eyebrow">{ui.languages[lang]}</dt>
      <dd>{person.languages[lang]}</dd>
    </div>
  </dl>
  <p class="eyebrow">
    {ui.forMachines[lang]} <a href="/llms.txt">tillfindl.com/llms.txt</a>. © {new Date().getFullYear()} {person.name}
  </p>
</footer>

<style>
  .footer {
    display: grid;
    gap: 2rem;
    max-width: var(--page);
    margin: 0 auto;
    padding: 3rem var(--gutter) 3rem;
  }

  dl {
    display: grid;
    gap: 1.25rem 3rem;
    margin: 0;
  }

  @media (min-width: 40rem) {
    dl {
      grid-template-columns: repeat(2, max-content);
    }
  }

  dd {
    margin: 0.35rem 0 0;
    font-size: var(--text-sm);
  }
</style>
