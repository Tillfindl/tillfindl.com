---
// The last block: an invitation to get in touch.
import { closing, links, type Lang } from '../content/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="closing block span-12" aria-labelledby="closing-title">
  <h2 id="closing-title">{closing.title[lang]}</h2>
  {
    links.linkedin ? (
      <a class="pill" href={links.linkedin} rel="me noopener">
        {closing.cta[lang]} <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <span class="pill">{closing.pending[lang]}</span>
    )
  }
</section>

<style>
  .closing {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 2rem;
    padding-block: calc(var(--pad) * 2);
  }

  h2 {
    max-width: 22em;
    font-size: var(--text-display);
    letter-spacing: -0.035em;
  }
</style>
