---
// The holding page shown until the real site is designed. Delete it when it is no longer used.
---

<main>
  <h1>Till Findl</h1>
  <p>New website coming soon.</p>
</main>

<style>
  main {
    min-height: 100svh;
    display: grid;
    place-content: center;
    gap: 0.75rem;
    padding: var(--gutter);
    text-align: center;
  }

  h1 {
    margin: 0;
    font-size: var(--text-xl);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.05;
    animation: rise 900ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  p {
    margin: 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
    letter-spacing: 0.02em;
    animation: rise 900ms 120ms cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  /* A short, calm entrance: fade in while drifting up a few pixels. */
  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(6px);
    }
  }
</style>
