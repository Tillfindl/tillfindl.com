---
// One section: a small label, then its paragraphs and photos in the text column (see `.row` in
// global.css). Photos come in two sizes only: landscape ones fill the text column, upright ones
// and pairs take half of it each. A strip becomes a grid across both columns and closes the
// section, so strips belong at the end of a section's blocks.
import { Image } from 'astro:assets';
import type { Block, Chapter, Lang, Photo } from '../content/profile';
import { photo } from '../content/images';
import { rich } from '../content/rich';

interface Props {
  chapter: Chapter;
  lang: Lang;
}

const { chapter, lang } = Astro.props;

const upright = (p: Photo) => {
  const { width, height } = photo(p.file);
  return height > width;
};
const position = (p: Photo) => (p.position ? `object-position: ${p.position}` : undefined);

type Strip = Extract<Block, { kind: 'strip' }>;
const content = chapter.blocks.filter((b) => b.kind !== 'strip');
const strips = chapter.blocks.filter((b): b is Strip => b.kind === 'strip');
---

<section class="row" id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
  <h2 class="label" id={`${chapter.id}-title`}>{chapter.title[lang]}</h2>
  <div class="content">
    {
      content.map((b) => {
        if (b.kind === 'p') return <p set:html={rich(b.text[lang])} />;
        if (b.kind === 'photo') {
          const tall = upright(b.photo);
          return (
            <figure class:list={['photo', tall ? 'half' : 'wide']}>
              <Image
                src={photo(b.photo.file)}
                alt={b.photo.alt[lang]}
                widths={tall ? [400, 640, 960] : [640, 960, 1280, 1600]}
                sizes={tall ? '(min-width: 52rem) 18rem, 50vw' : '(min-width: 52rem) 36rem, 100vw'}
                style={position(b.photo)}
              />
            </figure>
          );
        }
        if (b.kind === 'pair')
          return (
            <div class="pair">
              {b.photos.map((p) => (
                <Image src={photo(p.file)} alt={p.alt[lang]} widths={[400, 640, 960]} sizes="(min-width: 52rem) 18rem, 50vw" style={position(p)} />
              ))}
            </div>
          );
        return null;
      })
    }
  </div>
  {
    strips.map((b) => (
      <div class="grid full">
        {b.photos.map((p) => (
          <Image src={photo(p.file)} alt={p.alt[lang]} widths={[320, 480, 720]} sizes="(min-width: 52rem) 16rem, 50vw" style={position(p)} />
        ))}
      </div>
    ))
  }
</section>

<style>
  section {
    scroll-margin-top: var(--s-8);
  }

  /* Inside a section: 16px between paragraphs, 32px around photos (see the spacing scale). */
  .content > * + * {
    margin-top: var(--s-4);
  }

  .content > .photo,
  .content > .pair,
  .content > .photo + *,
  .content > .pair + * {
    margin-top: var(--s-8);
  }

  p :global(a) {
    color: var(--ink);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.2s;
  }

  p :global(a:hover) {
    text-decoration-color: var(--ink);
  }

  p :global(a span) {
    color: var(--muted);
  }

  section :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--line);
  }

  .wide :global(img) {
    aspect-ratio: 3 / 2;
  }

  /* An upright photo on its own takes the same width as one photo of a pair. */
  .half {
    width: calc((100% - var(--gap)) / 2);
  }

  .half :global(img),
  .pair :global(img),
  .grid :global(img) {
    aspect-ratio: 4 / 5;
  }

  .pair,
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }

  /* With the row's own 8px gap above it, 32px in all, like every other photo. */
  .grid {
    margin-top: var(--s-6);
  }

  @media (min-width: 52rem) {
    .grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
