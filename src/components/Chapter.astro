---
// One section: a numbered title, then its paragraphs and photos. On a phone everything runs in
// one column. From a tablet up there is a margin beside the text: an upright photo hangs there
// beside the paragraphs around it, while landscape photos, pairs and the strip run across both.
import { Image } from 'astro:assets';
import type { Block, Chapter, Lang, Photo } from '../content/profile';
import { photo } from '../content/images';
import { rich } from '../content/rich';

interface Props {
  chapter: Chapter;
  number: string;
  lang: Lang;
}

const { chapter, number, lang } = Astro.props;

const upright = (p: Photo) => {
  const { width, height } = photo(p.file);
  return height > width;
};

/*
 * An upright photo is grouped with the paragraph before it and the paragraphs after it into a
 * "run". On a phone the run reads in order; from a tablet up the paragraphs stack beside the
 * photo, and any height the photo has to spare goes below them rather than between them.
 */
type Paragraph = Extract<Block, { kind: 'p' }>;
type Item = { kind: 'block'; block: Block } | { kind: 'run'; before?: Paragraph; photo: Photo; after: Paragraph[] };
const items: Item[] = [];
for (let i = 0; i < chapter.blocks.length; i++) {
  const block = chapter.blocks[i];
  if (block.kind !== 'photo' || !upright(block.photo)) {
    items.push({ kind: 'block', block });
    continue;
  }
  const last = items.at(-1);
  const before = last?.kind === 'block' && last.block.kind === 'p' ? (items.pop(), last.block) : undefined;
  const after: Paragraph[] = [];
  while (chapter.blocks[i + 1]?.kind === 'p') after.push(chapter.blocks[++i] as Paragraph);
  items.push({ kind: 'run', before, photo: block.photo, after });
}

const position = (p: Photo) => (p.position ? `object-position: ${p.position}` : undefined);
---

<section class="chapter" id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
  <h2 id={`${chapter.id}-title`}><span class="n">{number}</span>{chapter.title[lang]}</h2>
  {
    items.map((item) => {
      if (item.kind === 'run')
        return (
          <div class:list={['run', !item.before && 'lead']}>
            {item.before && <p class="before" set:html={rich(item.before.text[lang])} />}
            <figure class="side" data-reveal>
              <Image src={photo(item.photo.file)} alt={item.photo.alt[lang]} widths={[400, 640, 960]} sizes="(min-width: 48rem) 16rem, 78vw" style={position(item.photo)} />
            </figure>
            {item.after.length > 0 && (
              <div class="after">
                {item.after.map((a) => (
                  <p set:html={rich(a.text[lang])} />
                ))}
              </div>
            )}
          </div>
        );
      const b = item.block;
      if (b.kind === 'p') return <p set:html={rich(b.text[lang])} />;
      if (b.kind === 'photo')
        return (
          <figure class="wide" data-reveal>
            <Image src={photo(b.photo.file)} alt={b.photo.alt[lang]} widths={[640, 960, 1280, 1600]} sizes="(min-width: 48rem) 53rem, 100vw" style={position(b.photo)} />
          </figure>
        );
      if (b.kind === 'pair')
        return (
          <div class="pair" data-reveal>
            {b.photos.map((p) => (
              <Image src={photo(p.file)} alt={p.alt[lang]} widths={[400, 640, 960]} sizes="(min-width: 48rem) 20rem, 46vw" style={position(p)} />
            ))}
          </div>
        );
      return (
        <div class="strip" data-reveal>
          {b.photos.map((p) => (
            <Image
              src={photo(p.file)}
              alt={p.alt[lang]}
              widths={[320, 480, 720]}
              sizes="(min-width: 73rem) 16vw, (min-width: 48rem) 31vw, 62vw"
              style={position(p)}
            />
          ))}
        </div>
      );
    })
  }
</section>

<style>
  /* --flow is the space between paragraphs and photos. */
  .chapter {
    --flow: 1.15rem;
    display: grid;
    row-gap: var(--flow);
    scroll-margin-top: 2rem;
  }

  .run,
  .after {
    display: grid;
    row-gap: var(--flow);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: 0.8rem;
    margin-bottom: 0.35rem;
    font-size: var(--text-title);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
  }

  .n {
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 500;
    letter-spacing: 0;
  }

  p {
    max-width: var(--measure);
    color: var(--body);
    font-size: var(--text-read);
    line-height: 1.7;
  }

  p :global(a) {
    color: var(--ink);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--border-hover);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.2s;
  }

  p :global(a:hover) {
    text-decoration-color: var(--ink);
  }

  p :global(a span) {
    color: var(--muted);
  }

  p :global(em) {
    color: var(--ink);
  }

  figure {
    margin: 0.6rem 0;
  }

  .chapter :global(img) {
    width: 100%;
    object-fit: cover;
    border-radius: var(--radius);
  }

  figure :global(img) {
    height: 100%;
  }

  /* An upright photo: narrower than the text on a phone, set to the right. */
  .side {
    justify-self: end;
    width: min(78%, 20rem);
    aspect-ratio: 3 / 4;
  }

  .wide {
    aspect-ratio: 3 / 2;
  }

  /* Two photos side by side, the second a little lower, as if laid down by hand. */
  .pair {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: start;
    gap: var(--gap);
    max-width: 40rem;
    margin: 0.6rem 0 2.5rem;
  }

  .pair :global(img) {
    aspect-ratio: 2 / 3;
  }

  .pair :global(img:last-child) {
    margin-top: 2.5rem;
  }

  /*
   * A row of photos that runs out to the edges of the screen (--bleed-start and --bleed-end are
   * the distances from the text to the edges, set in Page.astro); on a phone it scrolls sideways.
   */
  .strip {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 62vw;
    align-items: start;
    gap: var(--gap);
    margin: 1rem calc(-1 * var(--bleed-end)) 0 calc(-1 * var(--bleed-start));
    padding: 0 var(--side) 2rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--side);
    scrollbar-width: none;
  }

  .strip::-webkit-scrollbar {
    display: none;
  }

  .strip :global(img) {
    aspect-ratio: 4 / 5;
    scroll-snap-align: start;
  }

  .strip :global(img:nth-child(even)) {
    margin-top: 2rem;
  }

  @media (min-width: 48rem) {
    .chapter,
    .run {
      grid-template-columns: minmax(0, var(--measure)) minmax(0, var(--aside));
      column-gap: var(--column-gap);
    }

    .chapter > * {
      grid-column: 1;
    }

    .chapter > .wide,
    .chapter > .pair,
    .chapter > .strip,
    .chapter > .run {
      grid-column: 1 / -1;
    }

    /* The last row takes the photo's spare height, so the paragraphs beside it stay together. */
    .run {
      grid-template-rows: auto 1fr;
    }

    .before {
      grid-area: 1 / 1;
    }

    .after {
      grid-area: 2 / 1;
      align-self: start;
    }

    .lead .after {
      grid-row: 1;
    }

    .run > .side {
      grid-column: 2;
      grid-row: 1 / 3;
      align-self: start;
      justify-self: stretch;
      width: auto;
      margin: 0.35rem 0 0;
    }

    .strip {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      overflow: visible;
    }

    /* In three columns the middle one sits lower, rather than every other photo. */
    .strip :global(img:nth-child(even)) {
      margin-top: 0;
    }

    .strip :global(img:nth-child(3n + 2)) {
      margin-top: 2rem;
    }
  }

  @media (min-width: 73rem) {
    .strip {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .strip :global(img:nth-child(3n + 2)) {
      margin-top: 0;
    }

    .strip :global(img:nth-child(even)) {
      margin-top: 2rem;
    }
  }
</style>
