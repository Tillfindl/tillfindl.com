---
// One section: a small label, then its paragraphs and photos in the text column (see `.row` in
// global.css). Photos come in two sizes only: landscape ones fill the text column, upright ones
// and pairs take half of it each. Personal items sit two to a row at the same half width, each
// photo with a short title, a line on what Till loves about it, and the proof.
import { Image } from 'astro:assets';
import type { Chapter, Lang, Photo } from '../content/profile';
import { photo } from '../content/images';
import { rich } from '../content/rich';

interface Props {
  chapter: Chapter;
  lang: Lang;
}

const { chapter, lang } = Astro.props;

const upright = (p: Photo) => {
  const { width, height } = photo(p.file);
  return height > width;
};
const position = (p: Photo) => (p.position ? `object-position: ${p.position}` : undefined);
---

<section class="row" id={chapter.id} aria-labelledby={`${chapter.id}-title`}>
  <h2 class="label" id={`${chapter.id}-title`}>{chapter.title[lang]}</h2>
  <div class="content">
    {
      chapter.blocks.map((b) => {
        if (b.kind === 'p') return <p set:html={rich(b.text[lang])} />;
        if (b.kind === 'photo') {
          const tall = upright(b.photo);
          return (
            <figure class:list={['photo', tall ? 'half' : 'wide']}>
              <Image
                src={photo(b.photo.file)}
                alt={b.photo.alt[lang]}
                widths={tall ? [400, 640, 960] : [640, 960, 1280, 1600]}
                sizes={tall ? '(min-width: 52rem) 18rem, 50vw' : '(min-width: 52rem) 36rem, 100vw'}
                style={position(b.photo)}
              />
            </figure>
          );
        }
        if (b.kind === 'pair')
          return (
            <div class="pair">
              {b.photos.map((p) => (
                <Image src={photo(p.file)} alt={p.alt[lang]} widths={[400, 640, 960]} sizes="(min-width: 52rem) 18rem, 50vw" style={position(p)} />
              ))}
            </div>
          );
        return (
          <ul class="items">
            {b.items.map((item) => (
              <li>
                <Image src={photo(item.photo.file)} alt={item.photo.alt[lang]} widths={[400, 640, 960]} sizes="(min-width: 52rem) 18rem, 50vw" style={position(item.photo)} />
                <h3>{item.title[lang]}</h3>
                <p set:html={rich(item.text[lang])} />
                <p class="detail" set:html={rich(item.detail[lang])} />
              </li>
            ))}
          </ul>
        );
      })
    }
  </div>
</section>

<style>
  section {
    scroll-margin-top: var(--s-8);
  }

  /* Inside a section: 16px between paragraphs, 32px around photos (see the spacing scale). */
  .content > * + * {
    margin-top: var(--s-4);
  }

  .content > * + .photo,
  .content > * + .pair,
  .content > * + .items,
  .content > .photo + *,
  .content > .pair + *,
  .content > .items + * {
    margin-top: var(--s-8);
  }

  p :global(a) {
    color: var(--ink);
    white-space: nowrap;
    text-decoration: underline;
    text-decoration-color: var(--line);
    text-decoration-thickness: 1px;
    text-underline-offset: 0.22em;
    transition: text-decoration-color 0.2s;
  }

  p :global(a:hover) {
    text-decoration-color: var(--ink);
  }

  section :global(img) {
    width: 100%;
    height: auto;
    object-fit: cover;
    border-radius: var(--radius);
    background: var(--line);
  }

  .wide :global(img) {
    aspect-ratio: 3 / 2;
  }

  /* An upright photo on its own takes the same width as one photo of a pair. */
  .half {
    width: calc((100% - var(--gap)) / 2);
  }

  .half :global(img),
  .pair :global(img),
  .items :global(img) {
    aspect-ratio: 4 / 5;
  }

  .pair,
  .items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }

  /*
   * Personal items: two to a row, 32px between rows. The title sits 12px under the photo, then
   * what Till loves about it in body colour, then the proof in grey, 4px apart.
   */
  .items {
    row-gap: var(--s-8);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  h3 {
    margin-top: var(--s-3);
    color: var(--ink);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 1.4;
  }

  li p {
    margin-top: var(--s-1);
    font-size: var(--text-sm);
    line-height: 1.5;
  }

  li .detail {
    color: var(--muted);
  }
</style>
