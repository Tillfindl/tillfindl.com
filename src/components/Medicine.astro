---
// Till's medical background, with the graduation photos.
import { Image } from 'astro:assets';
import Section from './Section.astro';
import { medicine, photos, type Lang } from '../content/profile';
import { photo } from '../content/images';

interface Props {
  lang: Lang;
  orb: string;
}

const { lang, orb } = Astro.props;
---

<Section id="medicine" label={medicine.label[lang]} orb={orb}>
  <h2 id="medicine-title">{medicine.title[lang]}</h2>
  <div class="body">
    {medicine.body.map((p) => <p>{p[lang]}</p>)}
  </div>
  <div class="photos">
    {
      photos.medicine.map((p) => (
        <figure>
          <Image src={photo(p.file)} alt={p.alt[lang]} widths={[360, 540, 720]} sizes="(min-width: 60rem) 18rem, 45vw" />
          <figcaption>{p.caption[lang]}</figcaption>
        </figure>
      ))
    }
  </div>
</Section>

<style>
  h2 {
    font-size: var(--text-2xl);
  }

  .body {
    display: grid;
    gap: 1em;
    max-width: var(--measure);
    margin-top: 1.75rem;
    color: rgb(242 241 237 / 0.82);
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    max-width: var(--measure);
    margin-top: 2.5rem;
  }

  figure {
    margin: 0;
  }

  img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: 3px;
  }

  figcaption {
    margin-top: 0.5rem;
    color: var(--color-muted);
    font-size: var(--text-xs);
  }
</style>
