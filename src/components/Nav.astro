---
// The top bar: name, language switch and LinkedIn.
import { links, pathFor, person, ui, type Lang } from '../content/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const langs: Lang[] = ['en', 'de'];
---

<a class="skip visually-hidden" href="#content">{ui.skip[lang]}</a>
<nav class="nav" aria-label={lang === 'en' ? 'Site' : 'Seite'}>
  <a class="name" href={pathFor(lang)}>{person.name}</a>
  <div class="right">
    <ul class="langs">
      {
        langs.map((l) => (
          <li>
            <a href={pathFor(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined} title={ui.langName[l]}>
              {l.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
    {links.linkedin && <a href={links.linkedin} rel="me noopener">LinkedIn</a>}
  </div>
</nav>

<style>
  .skip:focus {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 10;
    width: auto;
    height: auto;
    padding: 0.5rem 0.75rem;
    clip-path: none;
    background: var(--color-ink);
    color: var(--color-bg);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: var(--page);
    margin: 0 auto;
    padding: 1.25rem var(--gutter);
    font-size: var(--text-sm);
  }

  a {
    text-decoration: none;
  }

  .name {
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .langs {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.06em;
  }

  .langs a {
    color: var(--color-faint);
  }

  .langs a[aria-current] {
    color: var(--color-ink);
  }

  .langs a:hover {
    color: var(--color-ink);
  }
</style>
