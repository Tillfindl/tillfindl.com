---
// The bar across the top: name, language switch, and the way to say hello. It stays in place
// and inverts against what is behind it, so it reads on photos, dark and light alike.
import { page, pathFor, person, type Lang } from '../content/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const langs: Lang[] = ['en', 'de'];
---

<a class="skip visually-hidden" href="#content">{page.skip[lang]}</a>
<nav class="nav" aria-label={lang === 'en' ? 'Site' : 'Seite'}>
  <a class="name" href={pathFor(lang)}>{person.name}</a>
  <div class="right">
    <ul class="langs">
      {
        langs.map((l) => (
          <li>
            <a href={pathFor(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
              {l.toUpperCase()}
            </a>
          </li>
        ))
      }
    </ul>
    <a class="hello" href="#hello">{page.nav.hello[lang]}</a>
  </div>
</nav>

<style>
  .skip:focus {
    position: fixed;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 20;
    width: auto;
    height: auto;
    padding: 0.5rem 0.75rem;
    clip-path: none;
    background: #fff;
    color: #000;
  }

  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: calc(1.25rem + env(safe-area-inset-top, 0px)) var(--side) 1.25rem;
    color: #fff;
    font-size: var(--text-sm);
    mix-blend-mode: difference;
  }

  a {
    text-decoration: none;
  }

  .name {
    font-size: 1.0625rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .right {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .langs {
    display: flex;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .langs a {
    opacity: 0.5;
  }

  .langs a[aria-current],
  .langs a:hover {
    opacity: 1;
  }

  .hello {
    padding: 0.55em 1.1em;
    border: 1px solid currentColor;
    border-radius: 999px;
  }
</style>
