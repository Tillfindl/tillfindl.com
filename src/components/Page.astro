---
// The whole page, in one language: name, one sentence and portrait, then work, a pair of
// photos, medicine, sport, other things, a row of photos and contact. Text cards and photo
// cards share one grid so they mix freely. /index.astro and /de/index.astro both render this.
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import InfoCard from './InfoCard.astro';
import PhotoCard from './PhotoCard.astro';
import Footer from './Footer.astro';
import { links, meta, page, pathFor, person, SITE_URL, text, type Lang } from '../content/profile';
import { photo } from '../content/images';
import { personJsonLd } from '../content/jsonld';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { sections, medicine } = page;
const og = await getImage({ src: photo(page.portrait.file), width: 800, height: 800, fit: 'cover', format: 'jpg' });
const jsonLd = personJsonLd(lang, new URL(og.src, SITE_URL).href);
const langs: Lang[] = ['en', 'de'];
---

<Base lang={lang} title={meta.title[lang]} description={meta.description[lang]} jsonLd={jsonLd}>
  <div class="lights" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

  <div class="page">
    <nav class="top" aria-label={lang === 'en' ? 'Language' : 'Sprache'}>
      {
        langs.map((l) => (
          <a href={pathFor(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>

    <header class="intro">
      <div class="text">
        <h1>{person.name}</h1>
        <p class="place">{page.place[lang]}</p>
        <p class="lede">{page.intro[lang]}</p>
        <div class="buttons">
          <a class="button primary" href={links.bounceback} rel="noopener">Bounceback <span aria-hidden="true">↗</span></a>
          <a class="button" href={links.eigen} rel="noopener">Eigen <span aria-hidden="true">↗</span></a>
          {links.linkedin && <a class="button" href={links.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <Image
        class="portrait"
        src={photo(page.portrait.file)}
        alt={page.portrait.alt[lang]}
        widths={[400, 640, 880]}
        sizes="(min-width: 48rem) 22rem, calc(100vw - 2.5rem)"
        loading="eager"
        fetchpriority="high"
      />
    </header>

    <main>
      <section aria-labelledby="work">
        <h2 id="work">{sections.work[lang]}</h2>
        <div class="bento">
          {page.work.map((c) => <InfoCard lang={lang} card={c} class="d-6" />)}
          {page.photoPair.map((p) => <PhotoCard lang={lang} photo={p} class="d-6 t-3 half tall" sizes="(min-width: 40rem) 30rem, 50vw" />)}
        </div>
      </section>

      <section aria-labelledby="medicine">
        <h2 id="medicine">{sections.medicine[lang]}</h2>
        <div class="bento">
          <InfoCard lang={lang} card={medicine.ucl} class="d-6">
            <div class="bsc">
              <div class="row">
                <p class="small muted">{medicine.bsc.title[lang]}</p>
                <span class="small muted nowrap">{medicine.bsc.date}</span>
              </div>
              <p class="body">{medicine.bsc.thesis[lang]}</p>
            </div>
          </InfoCard>
          {medicine.graduation.map((p) => <PhotoCard lang={lang} photo={p} class="d-3 t-3 half" sizes="(min-width: 60rem) 15rem, 50vw" />)}
          <PhotoCard lang={lang} photo={medicine.electivePhoto} class="d-6 landscape beside-3" sizes="(min-width: 60rem) 30rem, 100vw" />
          <InfoCard lang={lang} card={medicine.elective} class="d-6" />
          {medicine.other.map((c) => <InfoCard lang={lang} card={c} class="d-6 t-3" />)}
        </div>
      </section>

      <section aria-labelledby="sport">
        <h2 id="sport">{sections.sports[lang]}</h2>
        <div class="bento">
          {
            page.sports.map((s) => (
              <article class="card sport d-3 t-3 half">
                <Image
                  src={photo(s.file)}
                  alt={s.alt[lang]}
                  style={s.position ? `object-position: ${s.position}` : undefined}
                  widths={[320, 480, 720]}
                  sizes="(min-width: 60rem) 14rem, 45vw"
                />
                <div class="caption">
                  <h3>{s.title[lang]}</h3>
                  <p>
                    {s.lines.map((l, i) => (
                      <>
                        {i > 0 && <span> · </span>}
                        {l.url ? (
                          <a href={l.url} rel="noopener">
                            {l.text[lang]} <span aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          l.text[lang]
                        )}
                      </>
                    ))}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <section aria-labelledby="other">
        <h2 id="other">{sections.hobbies[lang]}</h2>
        <div class="bento">
          {page.hobbies.map((c) => <InfoCard lang={lang} card={c} class="d-3 t-3 half" />)}
          <PhotoCard lang={lang} photo={page.photoRow[0]} class="d-4 t-2 tall" sizes="(min-width: 60rem) 20rem, 100vw" />
          {page.photoRow.slice(1).map((p) => <PhotoCard lang={lang} photo={p} class="d-4 t-2 half tall" sizes="(min-width: 60rem) 20rem, 50vw" />)}
        </div>
      </section>

      <section aria-labelledby="contact">
        <h2 id="contact">{sections.contact[lang]}</h2>
        <div class="card contact">
          <p>{page.contact.text[lang]}</p>
          {
            links.linkedin ? (
              <a class="button primary" href={links.linkedin} rel="me noopener">
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="button">{page.contact.pending[lang]}</span>
            )
          }
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</Base>

<style>
  /* Soft spots of light that wander across the whole screen behind everything. */
  .lights {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .lights span {
    position: absolute;
    width: 42vmax;
    height: 42vmax;
    margin: -21vmax 0 0 -21vmax;
    border-radius: 50%;
    filter: blur(60px);
    animation: wander 34s ease-in-out infinite alternate;
  }

  .lights span:nth-child(1) {
    top: 10%;
    left: 15%;
    background: radial-gradient(circle, var(--light-a), transparent 68%);
  }

  .lights span:nth-child(2) {
    top: 45%;
    left: 85%;
    background: radial-gradient(circle, var(--light-b), transparent 68%);
    animation-duration: 41s;
    animation-delay: -12s;
    animation-direction: alternate-reverse;
  }

  .lights span:nth-child(3) {
    top: 85%;
    left: 35%;
    background: radial-gradient(circle, var(--light-c), transparent 68%);
    animation-duration: 47s;
    animation-delay: -25s;
  }

  .lights span:nth-child(4) {
    top: 25%;
    left: 60%;
    width: 30vmax;
    height: 30vmax;
    margin: -15vmax 0 0 -15vmax;
    background: radial-gradient(circle, var(--light-d), transparent 68%);
    animation-duration: 29s;
    animation-delay: -7s;
    animation-direction: alternate-reverse;
  }

  @keyframes wander {
    0% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(28vw, 18vh) scale(1.2);
    }
    66% {
      transform: translate(-18vw, 32vh) scale(0.9);
    }
    100% {
      transform: translate(12vw, -22vh) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lights span {
      animation: none;
    }
  }

  .page {
    max-width: calc(var(--page) + 2 * var(--side));
    margin: 0 auto;
    padding: 0 var(--side);
  }

  .top {
    display: flex;
    justify-content: flex-end;
    gap: 0.9rem;
    padding: 1.5rem 0;
    font-size: var(--text-sm);
  }

  .top a {
    color: var(--muted);
  }

  .top a[aria-current],
  .top a:hover {
    color: var(--ink);
  }

  /* Intro: name and buttons on the left, the portrait on the right; portrait first on a phone. */
  .intro {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1rem, 6vh, 4rem);
  }

  .intro :global(.portrait) {
    order: -1;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
  }

  @media (min-width: 48rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: end;
      gap: clamp(2.5rem, 6vw, 5rem);
    }

    .intro :global(.portrait) {
      order: 0;
    }
  }

  h1 {
    font-size: var(--text-name);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .place {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  main {
    display: grid;
    gap: var(--section-gap);
    margin-top: var(--section-gap);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: var(--text-card);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .lede {
    max-width: 30em;
    margin-top: 1.5rem;
    color: var(--body);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  .muted {
    color: var(--muted);
  }

  .small {
    font-size: var(--text-sm);
  }

  .nowrap {
    white-space: nowrap;
  }

  /*
   * One grid for text and photo cards. Two columns on a phone (every card full width unless it
   * is a `half`), six on a tablet (`t-*` spans), twelve on a desktop (`d-*` spans).
   */
  .bento {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--gap);
  }

  .bento > :global(*) {
    grid-column: span 2;
  }

  .bento > :global(.half) {
    grid-column: span 1;
  }

  @media (min-width: 40rem) {
    .bento {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }

    .bento > :global(*) {
      grid-column: span 6;
    }

    .bento > :global(.t-2) {
      grid-column: span 2;
    }

    .bento > :global(.t-3) {
      grid-column: span 3;
    }
  }

  @media (min-width: 60rem) {
    .bento {
      grid-template-columns: repeat(12, minmax(0, 1fr));
    }

    .bento > :global(.d-3) {
      grid-column: span 3;
    }

    .bento > :global(.d-4) {
      grid-column: span 4;
    }

    .bento > :global(.d-6) {
      grid-column: span 6;
    }

    .bento > :global(.d-8) {
      grid-column: span 8;
    }

    /* A photo that runs beside three stacked text cards, as tall as they are together. */
    .bento > :global(.beside-3) {
      grid-row: span 3;
      aspect-ratio: auto;
      min-height: 18rem;
    }
  }

  /* Photo cards with no text beside them need a height of their own. */
  .bento > :global(.tall) {
    height: clamp(15rem, 34vw, 28rem);
  }

  .bento > :global(.landscape) {
    aspect-ratio: 3 / 2;
  }

  .bento > :global(.photo-card:not(.tall):not(.landscape)) {
    min-height: 14rem;
  }

  /* The BSc sits at the foot of the UCL card, under a hairline. */
  .bsc {
    display: grid;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  :global(.lines) + .bsc {
    margin-top: 1.5rem;
  }

  .row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .body {
    color: var(--body);
  }

  /* Sports: a photo of Till doing each one, with the facts underneath. */
  .sport {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 0.5rem 0.5rem 1.1rem;
  }

  .sport :global(img) {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: calc(var(--radius) - 0.4rem);
  }

  .caption {
    display: grid;
    gap: 0.35rem;
    padding: 0 0.6rem;
  }

  .caption h3 {
    font-size: var(--text-base);
  }

  .caption p {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .caption a {
    color: var(--body);
  }

  .caption a span {
    color: var(--muted);
  }

  .caption a:hover,
  .caption a:hover span {
    color: var(--ink);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .contact p {
    color: var(--body);
  }
</style>
