---
// The whole page, in one language: name and portrait, then work, education, sport and contact
// as cards. /index.astro and /de/index.astro both render this.
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import InfoCard from './InfoCard.astro';
import Footer from './Footer.astro';
import { links, meta, page, pathFor, person, SITE_URL, type Lang } from '../content/profile';
import { photo } from '../content/images';
import { personJsonLd } from '../content/jsonld';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { sections, medicine } = page;
const og = await getImage({ src: photo(page.portrait.file), width: 800, height: 800, fit: 'cover', format: 'jpg' });
const jsonLd = personJsonLd(lang, new URL(og.src, SITE_URL).href);
const langs: Lang[] = ['en', 'de'];
---

<Base lang={lang} title={meta.title[lang]} description={meta.description[lang]} jsonLd={jsonLd}>
  <div class="lights" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

  <div class="page">
    <nav class="top" aria-label={lang === 'en' ? 'Language' : 'Sprache'}>
      {
        langs.map((l) => (
          <a href={pathFor(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>

    <header class="intro">
      <div class="text">
        <h1>{person.name}</h1>
        <p class="place">{page.place[lang]}</p>
        <p class="lede">{page.intro[lang]}</p>
        <div class="buttons">
          <a class="button primary" href={links.bounceback} rel="noopener">Bounceback <span aria-hidden="true">↗</span></a>
          <a class="button" href={links.eigen} rel="noopener">Eigen <span aria-hidden="true">↗</span></a>
          <a class="button" href={`mailto:${links.email}`}>{lang === 'en' ? 'Email' : 'E-Mail'}</a>
          {links.linkedin && <a class="button" href={links.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <Image
        class="portrait"
        src={photo(page.portrait.file)}
        alt={page.portrait.alt[lang]}
        widths={[400, 640, 880]}
        sizes="(min-width: 48rem) 22rem, calc(100vw - 2.5rem)"
        loading="eager"
        fetchpriority="high"
      />
    </header>

    <main>
      <section aria-labelledby="work">
        <h2 id="work">{sections.work[lang]}</h2>
        <div class="grid two">
          {page.work.map((c) => <InfoCard lang={lang} card={c} />)}
        </div>
      </section>

      <section aria-labelledby="background">
        <h2 id="background">{sections.background[lang]}</h2>
        <article class="card medicine">
          <div class="med-photos">
            {medicine.photos.map((p) => <Image src={photo(p.file)} alt={p.alt[lang]} widths={[320, 480, 640]} sizes="(min-width: 48rem) 12rem, 45vw" />)}
          </div>
          <div class="med-text">
            <div class="med-top">
              <h3>{medicine.title}</h3>
              <span class="muted small">{medicine.date}</span>
            </div>
            <p class="muted small">{medicine.detail[lang]}</p>
            <p class="med-about">{medicine.about[lang]}</p>
            <div class="bsc">
              <div class="med-top">
                <p class="muted small">{medicine.bsc.title[lang]}</p>
                <span class="muted small">{medicine.bsc.date}</span>
              </div>
              <p>{medicine.bsc.thesis[lang]}</p>
            </div>
          </div>
        </article>
        <div class="grid two after">
          {page.background.map((c) => <InfoCard lang={lang} card={c} />)}
        </div>
      </section>

      <section aria-labelledby="hobbies">
        <h2 id="hobbies">{sections.hobbies[lang]}</h2>
        <div class="grid sports">
          {
            page.sports.map((s) => (
              <article class="card sport">
                <Image src={photo(s.file)} alt={s.alt[lang]} style={s.position ? `object-position: ${s.position}` : undefined} widths={[320, 480, 720]} sizes="(min-width: 60rem) 14rem, (min-width: 40rem) 45vw, 70vw" />
                <div class="caption">
                  <h3>{s.title[lang]}</h3>
                  <p>
                    {s.lines.map((l, i) => (
                      <>
                        {i > 0 && <span class="dot"> · </span>}
                        {l.url ? (
                          <a href={l.url} rel="noopener">
                            {l.text[lang]} <span aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          l.text[lang]
                        )}
                      </>
                    ))}
                  </p>
                </div>
              </article>
            ))
          }
        </div>
        <div class="grid three after">
          {page.hobbies.map((c) => <InfoCard lang={lang} card={c} />)}
        </div>
      </section>

      <section aria-labelledby="contact">
        <h2 id="contact">{sections.contact[lang]}</h2>
        <div class="card contact">
          <p>{page.contact.text[lang]}</p>
          <a class="button primary" href={`mailto:${links.email}`}>{links.email}</a>
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</Base>

<style>
  /* Soft spots of light that wander across the whole screen behind everything. */
  .lights {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
  }

  .lights span {
    position: absolute;
    width: 42vmax;
    height: 42vmax;
    margin: -21vmax 0 0 -21vmax;
    border-radius: 50%;
    filter: blur(60px);
    animation: wander 34s ease-in-out infinite alternate;
  }

  .lights span:nth-child(1) {
    top: 10%;
    left: 15%;
    background: radial-gradient(circle, var(--light-a), transparent 68%);
  }

  .lights span:nth-child(2) {
    top: 45%;
    left: 85%;
    background: radial-gradient(circle, var(--light-b), transparent 68%);
    animation-duration: 41s;
    animation-delay: -12s;
    animation-direction: alternate-reverse;
  }

  .lights span:nth-child(3) {
    top: 85%;
    left: 35%;
    background: radial-gradient(circle, var(--light-c), transparent 68%);
    animation-duration: 47s;
    animation-delay: -25s;
  }

  .lights span:nth-child(4) {
    top: 25%;
    left: 60%;
    width: 30vmax;
    height: 30vmax;
    margin: -15vmax 0 0 -15vmax;
    background: radial-gradient(circle, var(--light-d), transparent 68%);
    animation-duration: 29s;
    animation-delay: -7s;
    animation-direction: alternate-reverse;
  }

  @keyframes wander {
    0% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(28vw, 18vh) scale(1.2);
    }
    66% {
      transform: translate(-18vw, 32vh) scale(0.9);
    }
    100% {
      transform: translate(12vw, -22vh) scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .lights span {
      animation: none;
    }
  }

  .page {
    max-width: calc(var(--page) + 2 * var(--side));
    margin: 0 auto;
    padding: 0 var(--side);
  }

  .top {
    display: flex;
    justify-content: flex-end;
    gap: 0.9rem;
    padding: 1.5rem 0;
    font-size: var(--text-sm);
  }

  .top a {
    color: var(--muted);
  }

  .top a[aria-current],
  .top a:hover {
    color: var(--ink);
  }

  /* Intro: name and buttons on the left, the portrait on the right; portrait first on a phone. */
  .intro {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1rem, 6vh, 4rem);
  }

  .intro :global(.portrait) {
    order: -1;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
  }

  @media (min-width: 48rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: end;
      gap: clamp(2.5rem, 6vw, 5rem);
    }

    .intro :global(.portrait) {
      order: 0;
    }
  }

  h1 {
    font-size: var(--text-name);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .place {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  main {
    display: grid;
    gap: var(--section-gap);
    margin-top: var(--section-gap);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  h3 {
    font-size: var(--text-card);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .muted {
    color: var(--muted);
  }

  .small {
    font-size: var(--text-sm);
  }

  .grid {
    display: grid;
    gap: var(--gap);
  }

  .after {
    margin-top: var(--gap);
  }

  @media (min-width: 40rem) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 48rem) {
    .three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  /* Medical school: two photos beside the details. */
  .medicine {
    display: grid;
    gap: 1.5rem;
  }

  .med-photos {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    align-self: start;
  }

  .med-photos :global(img) {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    border-radius: calc(var(--radius) - 0.4rem);
  }

  @media (min-width: 48rem) {
    .medicine {
      grid-template-columns: 24rem minmax(0, 1fr);
      gap: 2rem;
    }

    /* The photos run the full height of the card, beside however long the details are. */
    .med-photos {
      align-self: stretch;
    }

    .med-photos :global(img) {
      height: 100%;
      aspect-ratio: auto;
    }
  }

  .med-top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .med-text > p {
    margin-top: 0.3rem;
  }

  .med-text {
    display: flex;
    flex-direction: column;
  }

  /* The BSc sits at the foot of the medicine card, under a hairline. */
  .bsc {
    display: grid;
    gap: 0.4rem;
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--border);
  }

  .med-text > p + .bsc {
    margin-top: 2rem;
  }

  .med-about,
  .bsc p:not(.muted) {
    color: var(--body);
  }

  .med-about {
    margin-top: 0.75rem;
  }

  .lede {
    max-width: 30em;
    margin-top: 1.5rem;
    color: var(--body);
    font-size: var(--text-lg);
    line-height: 1.55;
  }

  /* Sports: a photo of Till doing each one, with the details underneath. */
  .sports {
    grid-auto-flow: column;
    grid-auto-columns: 72%;
    margin: 0 calc(-1 * var(--side));
    padding: 0 var(--side);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--side);
    scrollbar-width: none;
  }

  .sports > * {
    scroll-snap-align: start;
  }

  @media (min-width: 40rem) {
    .sports {
      grid-auto-flow: row;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      margin: 0;
      padding: 0;
      overflow: visible;
    }
  }

  @media (min-width: 60rem) {
    .sports {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .sport {
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: 0.5rem 0.5rem 1.1rem;
  }

  .sport :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: calc(var(--radius) - 0.4rem);
  }

  .caption {
    display: grid;
    gap: 0.35rem;
    padding: 0 0.6rem;
  }

  .caption h3 {
    font-size: var(--text-base);
  }

  .caption p {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .caption a {
    color: var(--body);
  }

  .caption a span {
    color: var(--muted);
  }

  .caption a:hover,
  .caption a:hover span {
    color: var(--ink);
  }

  .contact {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
  }

  .contact p {
    color: var(--body);
  }
</style>
