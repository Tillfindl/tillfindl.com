---
// The whole page, in one language: an intro beside the portrait, then sections of cards.
// /index.astro and /de/index.astro both render this.
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import InfoCard from './InfoCard.astro';
import Footer from './Footer.astro';
import { links, meta, page, pathFor, person, SITE_URL, type Lang } from '../content/profile';
import { photo } from '../content/images';
import { personJsonLd } from '../content/jsonld';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { sections } = page;
const og = await getImage({ src: photo(page.portrait.file), width: 800, height: 800, fit: 'cover', format: 'jpg' });
const jsonLd = personJsonLd(lang, new URL(og.src, SITE_URL).href);
const langs: Lang[] = ['en', 'de'];
---

<Base lang={lang} title={meta.title[lang]} description={meta.description[lang]} jsonLd={jsonLd}>
  <div class="page">
    <nav class="top" aria-label={lang === 'en' ? 'Language' : 'Sprache'}>
      {
        langs.map((l) => (
          <a href={pathFor(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>

    <header class="intro">
      <div class="text">
        <h1>{person.name}</h1>
        <p class="place">{page.place[lang]}</p>
        <p class="lede">{page.intro[lang]}</p>
        <div class="buttons">
          <a class="button primary" href={links.bounceback} rel="noopener">Bounceback <span aria-hidden="true">↗</span></a>
          <a class="button" href={links.eigen} rel="noopener">Eigen <span aria-hidden="true">↗</span></a>
          {links.linkedin && <a class="button" href={links.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <Image
        class="portrait"
        src={photo(page.portrait.file)}
        alt={page.portrait.alt[lang]}
        widths={[400, 640, 880]}
        sizes="(min-width: 48rem) 22rem, calc(100vw - 2.5rem)"
        loading="eager"
        fetchpriority="high"
      />
    </header>

    <main>
      <section aria-labelledby="work">
        <h2 id="work">{sections.work[lang]}</h2>
        <div class="grid two">
          {page.work.map((c) => <InfoCard lang={lang} card={c} />)}
        </div>
      </section>

      <section aria-labelledby="education">
        <h2 id="education">{sections.education[lang]}</h2>
        <div class="grid">
          {page.education.map((c) => <InfoCard lang={lang} card={c} />)}
        </div>
      </section>

      <section aria-labelledby="experience">
        <h2 id="experience">{sections.experience[lang]}</h2>
        <div class="grid">
          {page.experience.map((c) => <InfoCard lang={lang} card={c} />)}
        </div>
      </section>

      <section aria-labelledby="sport">
        <h2 id="sport">{sections.sport[lang]}</h2>
        <div class="grid three">
          {
            page.sportPhotos.map((s) => {
              const Tag = s.url ? 'a' : 'div';
              return (
                <Tag class="card photo-card" href={s.url} rel={s.url ? 'noopener' : undefined}>
                  <Image src={photo(s.file)} alt={s.alt[lang]} widths={[320, 480, 720]} sizes="(min-width: 48rem) 19rem, calc(100vw - 2.5rem)" />
                  <div class="caption">
                    <h3>
                      {s.title[lang]}
                      {s.url && <span class="arrow" aria-hidden="true">↗</span>}
                    </h3>
                    <span>{s.detail[lang]}</span>
                  </div>
                </Tag>
              );
            })
          }
        </div>
        <div class="grid two races">
          {page.races.map((c) => <InfoCard lang={lang} card={c} />)}
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</Base>

<style>
  .page {
    max-width: calc(var(--page) + 2 * var(--side));
    margin: 0 auto;
    padding: 0 var(--side);
  }

  .top {
    display: flex;
    justify-content: flex-end;
    gap: 0.9rem;
    padding: 1.5rem 0;
    font-size: var(--text-sm);
  }

  .top a {
    color: var(--muted);
  }

  .top a[aria-current],
  .top a:hover {
    color: var(--ink);
  }

  /* Intro: words on the left, the portrait on the right; stacked with the portrait first on a phone. */
  .intro {
    display: grid;
    gap: 2rem;
    padding-top: clamp(1rem, 6vh, 4rem);
  }

  .intro :global(.portrait) {
    order: -1;
    width: 100%;
    max-width: 22rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border: 1px solid var(--border);
    border-radius: 1.25rem;
  }

  @media (min-width: 48rem) {
    .intro {
      grid-template-columns: minmax(0, 1fr) 22rem;
      align-items: center;
      gap: clamp(2.5rem, 6vw, 5rem);
    }

    .intro :global(.portrait) {
      order: 0;
    }
  }

  h1 {
    font-size: var(--text-name);
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .place {
    margin-top: 0.75rem;
    color: var(--muted);
  }

  .lede {
    max-width: 32em;
    margin-top: 1.75rem;
    color: var(--body);
    font-size: var(--text-lg);
    line-height: 1.6;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  main {
    display: grid;
    gap: var(--section-gap);
    margin-top: var(--section-gap);
  }

  h2 {
    margin-bottom: 1rem;
    font-size: 1.375rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .grid {
    display: grid;
    gap: var(--gap);
  }

  @media (min-width: 48rem) {
    .two {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .three {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .races {
    margin-top: var(--gap);
  }

  /* On a phone the sport photos slide sideways instead of stacking into a long column. */
  @media (max-width: 47.99rem) {
    .three {
      grid-auto-flow: column;
      grid-auto-columns: 72%;
      margin: 0 calc(-1 * var(--side));
      padding: 0 var(--side);
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--side);
      scrollbar-width: none;
    }

    .three > :global(*) {
      scroll-snap-align: start;
    }
  }

  /* Sport cards: the photo fills the top of the card, the name sits under it. */
  .photo-card {
    display: grid;
    gap: 0.9rem;
    padding: 0.5rem 0.5rem 1rem;
  }

  .photo-card :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: calc(var(--radius) - 0.4rem);
  }

  .caption {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    padding: 0 0.6rem;
  }

  .caption h3 {
    font-size: var(--text-base);
    font-weight: 600;
  }

  .caption span {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .caption .arrow {
    margin-left: 0.3em;
    font-weight: 400;
  }

  a.photo-card:hover .arrow {
    color: var(--ink);
  }
</style>
