---
// The whole page, in one language: a name, a small portrait, and a few plain lists.
// /index.astro and /de/index.astro both render this.
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Rows from './Rows.astro';
import Footer from './Footer.astro';
import { links, meta, page, pathFor, person, SITE_URL, type Lang } from '../content/profile';
import { photo } from '../content/images';
import { personJsonLd } from '../content/jsonld';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { sections } = page;
const portrait = await getImage({ src: photo(page.portrait.file), width: 800, height: 800, fit: 'cover', format: 'jpg' });
const jsonLd = personJsonLd(lang, new URL(portrait.src, SITE_URL).href);
const langs: Lang[] = ['en', 'de'];
---

<Base lang={lang} title={meta.title[lang]} description={meta.description[lang]} jsonLd={jsonLd}>
  <div class="column">
    <header>
      <Image class="portrait" src={photo(page.portrait.file)} alt={page.portrait.alt[lang]} width={128} height={128} fit="cover" loading="eager" />
      <h1>{person.name}</h1>
      <nav aria-label={lang === 'en' ? 'Language' : 'Sprache'}>
        {
          langs.map((l) => (
            <a href={pathFor(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
              {l.toUpperCase()}
            </a>
          ))
        }
        {links.linkedin && <a href={links.linkedin} rel="me noopener">LinkedIn ↗</a>}
      </nav>
    </header>

    <main>
      <Rows lang={lang} label={sections.work[lang]} rows={page.work} />
      <Rows lang={lang} label={sections.education[lang]} rows={page.education} />
      <Rows lang={lang} label={sections.experience[lang]} rows={page.experience} />
      <Rows lang={lang} label={sections.sport[lang]} rows={page.sport}>
        <ul class="photos">
          {
            page.photos.map((p) => (
              <li>
                <Image src={photo(p.file)} alt={p.alt[lang]} widths={[240, 400, 600]} sizes="(min-width: 40rem) 12.5rem, 30vw" />
              </li>
            ))
          }
        </ul>
      </Rows>
    </main>

    <Footer lang={lang} />
  </div>
</Base>

<style>
  .column {
    max-width: calc(var(--column) + 2 * var(--side));
    margin: 0 auto;
    padding: clamp(3.5rem, 12vh, 7rem) var(--side) 0;
  }

  header {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  header :global(.portrait) {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 50%;
    object-fit: cover;
  }

  h1 {
    flex: 1;
    font-size: var(--text-name);
    font-weight: 500;
    letter-spacing: -0.01em;
  }

  nav {
    display: flex;
    gap: 0.75rem;
    font-size: var(--text-sm);
  }

  nav a {
    color: var(--muted);
  }

  nav a[aria-current],
  nav a:hover {
    color: var(--ink);
  }

  main {
    display: grid;
    gap: var(--section-gap);
    margin-top: var(--section-gap);
  }

  .photos {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 1.25rem 0 0;
    padding: 0;
    list-style: none;
  }

  .photos :global(img) {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 0.375rem;
  }

</style>
