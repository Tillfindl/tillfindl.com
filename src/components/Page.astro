---
// The whole one-pager, in one language: a story in blocks. /index.astro and /de/index.astro
// both render this.
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Nav from './Nav.astro';
import Intro from './Intro.astro';
import Block from './Block.astro';
import Closing from './Closing.astro';
import Footer from './Footer.astro';
import { meta, photos, SITE_URL, story, type Lang } from '../content/profile';
import { photo } from '../content/images';
import { personJsonLd } from '../content/jsonld';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const portrait = await getImage({ src: photo(photos.portrait.file), width: 800, height: 800, fit: 'cover', format: 'jpg' });
const jsonLd = personJsonLd(lang, new URL(portrait.src, SITE_URL).href);
---

<Base lang={lang} title={meta.title[lang]} description={meta.description[lang]} jsonLd={jsonLd}>
  <Nav lang={lang} />
  <main id="content" class="grid">
    <Intro lang={lang} />
    {story.map((block) => <Block lang={lang} block={block} />)}
    <Closing lang={lang} />
  </main>
  <Footer lang={lang} />
</Base>

<style>
  .grid {
    max-width: var(--page);
    margin: 0 auto;
    padding: 0 var(--gutter);
  }
</style>
