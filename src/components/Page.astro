---
// The whole page, in one language: the portrait, name, one line and the two links, then the
// sections and contact. Everything sits on the same two columns (`.row` in global.css), so it
// all shares one left edge. /index.astro and /de/index.astro both render this.
import { getImage, Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Chapter from './Chapter.astro';
import Footer from './Footer.astro';
import { links, meta, page, pathFor, person, SITE_URL, type Lang } from '../content/profile';
import { photo } from '../content/images';
import { personJsonLd } from '../content/jsonld';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const og = await getImage({ src: photo(page.portrait.file), width: 800, height: 800, fit: 'cover', format: 'jpg' });
const jsonLd = personJsonLd(lang, new URL(og.src, SITE_URL).href);
const langs: Lang[] = ['en', 'de'];
---

<Base lang={lang} title={meta.title[lang]} description={meta.description[lang]} jsonLd={jsonLd}>
  <div class="page">
    <nav class="top" aria-label={lang === 'en' ? 'Language' : 'Sprache'}>
      {
        langs.map((l) => (
          <a href={pathFor(l)} hreflang={l} lang={l} aria-current={l === lang ? 'page' : undefined}>
            {l.toUpperCase()}
          </a>
        ))
      }
    </nav>

    <header class="row hero">
      <Image
        class="portrait"
        src={photo(page.portrait.file)}
        alt={page.portrait.alt[lang]}
        widths={[256, 384, 512]}
        sizes="11rem"
        loading="eager"
        fetchpriority="high"
      />
      <div>
        <h1>{person.name}</h1>
        <p class="lede">{page.intro[lang]}</p>
        <div class="buttons">
          <a class="button primary" href={links.bounceback} rel="noopener">Bounceback <span aria-hidden="true">↗</span></a>
          <a class="button" href={links.eigen} rel="noopener">Eigen <span aria-hidden="true">↗</span></a>
          {links.linkedin && <a class="button" href={links.linkedin} rel="me noopener">LinkedIn <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
    </header>

    <main>
      {page.chapters.map((c) => <Chapter chapter={c} lang={lang} />)}

      <section class="row" id="contact" aria-labelledby="contact-title">
        <h2 class="label" id="contact-title">{page.contact.title[lang]}</h2>
        <div class="contact">
          <p>{page.contact.text[lang]}</p>
          {
            links.linkedin ? (
              <a class="button primary" href={links.linkedin} rel="me noopener">
                LinkedIn <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="button pending">{page.contact.pending[lang]}</span>
            )
          }
        </div>
      </section>
    </main>

    <Footer lang={lang} />
  </div>
</Base>

<style>
  /* One reading column below 52rem (so a tablet keeps the same line length), both columns above. */
  .page {
    max-width: calc(var(--measure) + 2 * var(--side));
    margin: 0 auto;
    padding: 0 var(--side);
  }

  @media (min-width: 52rem) {
    .page {
      max-width: calc(var(--page) + 2 * var(--side));
    }
  }

  .top {
    display: flex;
    justify-content: flex-end;
    gap: var(--s-4);
    padding: var(--s-6) 0;
    font-size: var(--text-sm);
  }

  .top a {
    color: var(--muted);
    transition: color 0.2s;
  }

  .top a[aria-current],
  .top a:hover {
    color: var(--ink);
  }

  /* The intro: portrait in the label column, name, line and links in the text column. */
  .hero {
    row-gap: var(--s-6);
    padding-top: var(--s-8);
  }

  .hero :global(.portrait) {
    width: 8rem;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% 30%;
    border-radius: var(--radius);
    background: var(--line);
  }

  h1 {
    color: var(--ink);
    font-size: var(--text-name);
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .lede {
    margin-top: var(--s-3);
    color: var(--body);
    font-size: var(--text-lg);
    line-height: 1.5;
  }

  .buttons {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2);
    margin-top: var(--s-6);
  }

  @media (min-width: 52rem) {
    .hero {
      align-items: end;
      padding-top: var(--s-16);
    }

    .hero :global(.portrait) {
      width: 100%;
    }
  }

  main {
    display: grid;
    gap: var(--section);
    margin-top: var(--section);
  }

  .contact {
    display: grid;
    justify-items: start;
    gap: var(--s-6);
  }

  .pending {
    color: var(--muted);
  }

  .pending:hover {
    border-color: var(--line);
  }
</style>
