---
// A photo on its own, filling a card. No caption: the description is for screen readers and
// search engines only.
import { Image } from 'astro:assets';
import type { Lang, Photo } from '../content/profile';
import { photo } from '../content/images';

interface Props {
  lang: Lang;
  photo: Photo;
  /** Extra classes, usually the card's width and shape in the grid. */
  class?: string;
  sizes?: string;
}

const { lang, photo: p, class: extra, sizes = '(min-width: 60rem) 30rem, 100vw' } = Astro.props;
---

<figure class:list={['photo-card', extra]}>
  <Image
    src={photo(p.file)}
    alt={p.alt[lang]}
    widths={[400, 640, 960, 1280]}
    sizes={sizes}
    style={p.position ? `object-position: ${p.position}` : undefined}
  />
</figure>

<style>
  .photo-card {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
