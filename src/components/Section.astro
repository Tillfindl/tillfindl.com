---
// One chapter of the page: a small label, an optional slot for the orb on phones, and content.
// `orb` names the dot shape the orb morphs into while this section is on screen.
interface Props {
  id: string;
  label: string;
  orb?: string;
}

const { id, label, orb } = Astro.props;
---

<section class="section" id={id} data-orb={orb} aria-labelledby={`${id}-title`}>
  <header class="head">
    <p class="label">{label}</p>
    {orb && <div class="orb-slot" data-orb-slot aria-hidden="true"></div>}
  </header>
  <slot />
</section>

<style>
  .section {
    scroll-margin-top: 2rem;
  }

  .section + :global(.section) {
    margin-top: var(--section-gap);
  }

  .head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-rule);
  }

  /* On a phone the orb moves into the slot of the section in view; on wider screens it has its own column. */
  .orb-slot {
    width: 5.5rem;
    height: 5.5rem;
    margin: -0.5rem -0.75rem -1.5rem 0;
    flex: none;
  }

  @media (min-width: 60rem) {
    .orb-slot {
      display: none;
    }
  }
</style>
