---
// The site: Till's story staged as scenes you scroll through (src/scripts/experience.ts drives
// them). The look is white paper with everything written in ballpoint blue, apart from the name and
// the one button. Every photo is a real Polaroid that develops as it arrives, and the wards and
// Bounceback are a pen drawing.
//
// The words are short handwritten phrases (`page.script`) in the normal page flow, so they move
// exactly with the reader's finger. Medicine pairs every phrase with its own print, which scrolls
// past beside it (above it on a phone), a little slower than the words. On a wide screen the other
// scenes are a picture that stays in place (a sticky `.visual`) with the phrases passing to its left
// (`.script`), each phrase setting the picture moving as it is read. On a phone the wards drawing
// stays in place too, near the top, and its phrases come up one at a time to rest beneath it; Eigen's
// cued phrases each have their own picture just above it (a `.shot`), alternately left and right, so
// the page zigzags down and words and pictures never overlap. Personal zigzags the same way on both.
// The hero plays on CSS alone, so it starts before the script loads. Without JavaScript, or with
// reduced motion, it reads as a plain page (`.plain`) made from the same phrases: the staged layout
// only applies under `.js` and `prefers-reduced-motion: no-preference`.
import '@fontsource/mynerve/latin-400.css';
import { getImage } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Polaroid from './Polaroid.astro';
import Letters from './Letters.astro';
import WardsDrawing from './WardsDrawing.astro';
import { links, meta, page, person, SITE_URL, type Lang, type Phrase, type Photo } from '../content/profile';
import { photo } from '../content/images';
import { rich } from '../content/rich';
import { paragraph, phraseHtml } from '../content/phrase';
import { personJsonLd } from '../content/jsonld';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const { script, sections, items } = page;
const og = await getImage({ src: photo(page.portrait.file), width: 800, height: 800, fit: 'cover', format: 'jpg' });
const jsonLd = personJsonLd(lang, new URL(og.src, SITE_URL).href);
const caption = (p: Photo) => page.captions[p.file]?.[lang];
/** A list of phrases as one paragraph of HTML, for the plain page. */
const say = (list: (Phrase | Phrase['t'])[]) => rich(paragraph(list.map((p) => ('t' in p ? p.t : p)[lang])));

// The top line, written either side of the portrait like a note beside a photo.
const [introA, ...introRest] = page.intro[lang].split(/(?<=[.!?])\s+/);
const introB = introRest.join(' ');

/** Where each phrase sits across its column, in turn (left, indented, right), like overlays placed by hand. */
const PLACES = ['l', 'i', 'r', 'i'] as const;

/**
 * On a phone, the picture that goes above each of Eigen's cued phrases (`.shot`): the run club print
 * with its lap, the workshop print, or the dots. (The wards drawing stays in place instead.)
 */
const SHOTS: Record<string, 'run' | 'work' | 'dots'> = {
  lap: 'run',
  max: 'work',
  masks: 'dots',
  pivot: 'dots',
};
/** The shots alternate sides down the page, starting on the left. */
let shotCount = 0;
const nextSide = () => (shotCount++ % 2 ? 'r' : 'l');

/** The lap drawn round the run club print, in its 500 × 486 box. */
const ROUTE = 'M74 372 C18 262 40 118 152 58 C262 2 424 30 472 150 C522 272 452 424 322 458 C200 490 78 452 50 330 C40 288 48 250 66 218';

/** Square crops for the Polaroids, so the person stays in frame. */
const CROP: Record<string, string> = {
  'portrait-harris.jpg': '50% 40%',
  'ucl-medical-school.jpg': '50% 66%',
  'ucl-portico.jpg': '50% 72%',
  'theatre-kl.jpg': '72% 50%',
  'run-club.jpg': '50% 85%',
  'workshop.jpg': '50% 72%',
  'ironman-swim.jpg': '45% 40%',
  'ironman-transition.jpg': '50% 45%',
  'yetis-team.jpg': '50% 40%',
  'ski-gate.jpg': '72% 50%',
  'ski-podium.jpg': '50% 30%',
  'ski-carve.jpg': '50% 52%',
  'snowcat.jpg': '50% 55%',
  'bike-sunset.jpg': '50% 60%',
  'hockey-fisheye.jpg': '50% 50%',
  'summer-austria.jpg': '50% 60%',
  'lofoten-cabins.jpg': '50% 45%',
  'defender-river.jpg': '45% 50%',
  'dolomites.jpg': '50% 62%',
  'nashville.jpg': '45% 55%',
  'hallstatt.jpg': '50% 50%',
};
---

<Base lang={lang} title={meta.title[lang]} description={meta.description[lang]} jsonLd={jsonLd}>
  <script is:inline>document.documentElement.classList.add('js');</script>
  <div class="xp">
    <div class="xp-bg" aria-hidden="true"></div>
    <div class="progress" aria-hidden="true"></div>
    <!-- A blur along one axis only: motion blur, for the quick trip back to the top. -->
    <svg class="fx" width="0" height="0" aria-hidden="true" focusable="false">
      <filter id="motion-blur" x="0" y="-20%" width="100%" height="140%" color-interpolation-filters="sRGB">
        <feGaussianBlur stdDeviation="0 0"></feGaussianBlur>
      </filter>
    </svg>

    <header class="hud">
      <a href="#top" class="hud-name">{person.name}</a>
      <nav aria-label={lang === 'en' ? 'Language' : 'Sprache'}>
        <a href="/" hreflang="en" lang="en" aria-current={lang === 'en' ? 'page' : undefined}>EN</a>
        <a href="/de/" hreflang="de" lang="de" aria-current={lang === 'de' ? 'page' : undefined}>DE</a>
      </nav>
    </header>

    <main>
      <!-- 1. Opening: the portrait comes out of a camera and develops while the note is written beside it. -->
      <section class="scene opening" id="top" style={`--na: ${[...introA].length}`}>
        <div class="stage">
          <div class="o-head"><h1 class="logo">{person.name}</h1></div>
          <div class="o-pen o-pen-a"><p><Letters text={introA} /></p></div>
          <div class="o-photo">
            <svg class="camera" viewBox="0 0 300 190" aria-hidden="true">
              <rect pathLength="1" x="6" y="6" width="288" height="178" rx="24"></rect>
              <path pathLength="1" d="M6 62 H98 M202 62 H294"></path>
              <rect pathLength="1" x="30" y="24" width="46" height="28" rx="6"></rect>
              <rect pathLength="1" x="222" y="22" width="50" height="26" rx="4"></rect>
              <path pathLength="1" d="M230 30 h34 M230 37 h34 M230 44 h34"></path>
              <circle pathLength="1" cx="150" cy="96" r="50"></circle>
              <circle pathLength="1" cx="150" cy="96" r="33"></circle>
              <circle pathLength="1" cx="150" cy="96" r="13"></circle>
              <circle pathLength="1" cx="58" cy="116" r="10"></circle>
              <rect pathLength="1" x="34" y="166" width="232" height="12" rx="6"></rect>
            </svg>
            <div class="eject">
              <div class="print">
                <Polaroid photo={page.portrait} lang={lang} position={CROP[page.portrait.file]} sizes="(min-width: 52rem) 19rem, 52vw" eager film="auto" />
              </div>
            </div>
          </div>
          <div class="o-pen o-pen-b"><p><Letters text={introB} /></p></div>
        </div>
      </section>

      <!-- 2. Medicine: every phrase with its own print beside it, both scrolling past together. -->
      <section class="scene medicine">
        <div class="plain">
          <h2 class="label">{sections.medicine[lang]}</h2>
          <p set:html={say(script.medicine)} />
        </div>
        <div class="pairs">
          <h2 class="label phr"><span class="phr-in">{sections.medicine[lang]}</span></h2>
          {
            script.medicine.map((p, i) => (
              <div class:list={['pair', { flip: i % 2 === 1 }]}>
                <div class="phr">
                  <p class="phr-in" set:html={phraseHtml(p.t[lang])} />
                </div>
                {p.print && (
                  <div class="pp">
                    <div class="pp-in">
                      <Polaroid
                        photo={p.print}
                        lang={lang}
                        caption={caption(p.print)}
                        position={CROP[p.print.file]}
                        sizes="(min-width: 52rem) 28rem, 62vw"
                        film="latent"
                      />
                    </div>
                  </div>
                )}
              </div>
            ))
          }
        </div>
      </section>

      <!-- 3 and 4. The wards and Bounceback: one pen drawing, set moving by the phrases beside it. -->
      <section class="scene care">
        <div class="plain">
          <p set:html={say(script.wards)} />
          <h2 class="label">{sections.bounceback[lang]}</h2>
          <p set:html={say(script.bounceback)} />
        </div>
        <div class="visual">
          <div class="v-in">
            <div class="draw-wrap"><WardsDrawing lang={lang} /></div>
          </div>
        </div>
        <div class="script">
          {
            [...script.wards, null, ...script.bounceback].map((p, i) =>
              p === null ? (
                <h2 class="label phr">
                  <span class="phr-in">{sections.bounceback[lang]}</span>
                </h2>
              ) : (
                <div class="phr" data-cue={p.cue} data-at={PLACES[i % PLACES.length]} data-space={p.space}>
                  <p class="phr-in" set:html={phraseHtml(p.t[lang])} />
                </div>
              ),
            )
          }
        </div>
      </section>

      <!-- 5. Eigen: the run club print with a lap drawn round it, the workshop print, then dots form a face with a mask and stream into a footprint. -->
      <section class="scene eigen">
        <div class="plain">
          <h2 class="label">{sections.eigen[lang]}</h2>
          <p set:html={say(script.eigen)} />
        </div>
        <div class="visual">
          <div class="v-in">
            <div class="run">
              <div class="run-in">
                <svg class="route" viewBox="0 0 500 486" aria-hidden="true">
                  <path class="route-path" d={ROUTE}></path>
                  <circle class="runner" r="7" cx="74" cy="372"></circle>
                </svg>
                <Polaroid
                  photo={page.eigenPrints.run}
                  lang={lang}
                  caption={caption(page.eigenPrints.run)}
                  position={CROP[page.eigenPrints.run.file]}
                  sizes="(min-width: 52rem) 19rem, 50vw"
                  film="latent"
                />
              </div>
            </div>
            <div class="work">
              <div class="work-in">
                <Polaroid photo={page.eigenPrints.workshop} lang={lang} position={CROP[page.eigenPrints.workshop.file]} sizes="(min-width: 52rem) 14rem, 40vw" film="latent" />
              </div>
            </div>
            <canvas class="dots" aria-hidden="true"></canvas>
          </div>
        </div>
        <div class="script">
          <h2 class="label phr"><span class="phr-in">{sections.eigen[lang]}</span></h2>
          {
            script.eigen.map((p, i) => (
              <>
                {p.cue && SHOTS[p.cue] === 'run' && (
                  <div class="shot" data-cue={p.cue} data-kind="run" data-side={nextSide()}>
                    <div class="run-in">
                      <svg class="route" viewBox="0 0 500 486" aria-hidden="true">
                        <path class="route-path" d={ROUTE}></path>
                        <circle class="runner" r="7" cx="74" cy="372"></circle>
                      </svg>
                      <Polaroid
                        photo={page.eigenPrints.run}
                        lang={lang}
                        caption={caption(page.eigenPrints.run)}
                        position={CROP[page.eigenPrints.run.file]}
                        sizes="52vw"
                        film="latent"
                      />
                    </div>
                  </div>
                )}
                {p.cue && SHOTS[p.cue] === 'work' && (
                  <div class="shot" data-cue={p.cue} data-kind="work" data-side={nextSide()}>
                    <Polaroid photo={page.eigenPrints.workshop} lang={lang} position={CROP[page.eigenPrints.workshop.file]} sizes="52vw" film="latent" />
                  </div>
                )}
                {p.cue && SHOTS[p.cue] === 'dots' && (
                  <div class="shot" data-cue={p.cue} data-kind="dots" data-side={nextSide()}>
                    <canvas class="dots-shot" aria-hidden="true"></canvas>
                  </div>
                )}
                <div class="phr" data-cue={p.cue} data-at={PLACES[i % PLACES.length]} data-space={p.space}>
                  <p class="phr-in" set:html={phraseHtml(p.t[lang])} />
                </div>
              </>
            ))
          }
        </div>
      </section>

      <!-- 6. Personal: one interest after another, zigzagging down the page; each print develops as it comes up. -->
      <section class="scene personal">
        <div class="p-intro">
          <h2 class="label">{sections.personal[lang]}</h2>
          <p class="lead" set:html={phraseHtml(script.personal[lang])} />
        </div>
        {
          items.map((it, i) => (
            <div class:list={['topic', { flip: i % 2 === 1 }]}>
              <div class="t-text">
                <h3>
                  <Letters text={it.title[lang]} />
                </h3>
                <p class="love" set:html={rich(it.text[lang])} />
                {it.detail && <p class="detail" set:html={rich(it.detail[lang])} />}
              </div>
              <div class="t-prints">
                {it.prints.map((p) => (
                  <div class:list={['gp', { wide: p.wide }]}>
                    <div class="gp-in">
                      <Polaroid
                        photo={p}
                        lang={lang}
                        caption={caption(p)}
                        position={CROP[p.file]}
                        sizes={p.wide ? '(min-width: 52rem) 34rem, 92vw' : '(min-width: 52rem) 17rem, 45vw'}
                        film="latent"
                      />
                    </div>
                  </div>
                ))}
              </div>
            </div>
          ))
        }
      </section>

      <!-- 7. Ending: the contact line written in ballpoint, the name as a wordmark. -->
      <section class="scene ending">
        <div class="end-inner">
          <h2 class="label">{sections.contact[lang]}</h2>
          <p class="contact-line" set:html={phraseHtml(script.contact[lang], { letters: true })} />
          <div class="end-actions">
            {
              links.linkedin ? (
                <a class="button primary" href={links.linkedin} rel="me noopener">
                  LinkedIn
                </a>
              ) : (
                <span class="button pending">{page.pending[lang]}</span>
              )
            }
            <a class="top-link" href="#top">{page.footer.top[lang]}</a>
          </div>
        </div>
        <footer class="foot">
          <span>© {new Date().getFullYear()} {person.name}</span>
          <a class="machines" href="/llms.txt">{page.footer.forMachines[lang]}</a>
        </footer>
        <div class="end-mark" aria-hidden="true">
          <p class="wordmark">{[...person.name].map((c) => <span class="c">{c === ' ' ? ' ' : c}</span>)}</p>
        </div>
      </section>
    </main>
  </div>

  <script>
    import '../scripts/experience';
  </script>
</Base>

<style>
  /* ---------- Plain page (no JavaScript, or reduced motion) ---------- */

  /*
   * White paper, and every word in ballpoint blue capitals like the ads. The name, the wordmark
   * and the one button stay in the page's typeface.
   */
  .xp {
    --bg: #f0f0ed;
    --ink: #141413;
    --muted: #76746e;
    --line: #d9d8d2;
    --pen: #2f3394;
    --pen-font: 'Mynerve', cursive;
    position: relative;
    overflow-x: clip;
    color: var(--pen);
    font-family: var(--pen-font);
    font-size: 1.15rem;
    line-height: 1.32;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .logo,
  .hud-name,
  .wordmark,
  .button {
    font-family: var(--font-sans);
    letter-spacing: normal;
    text-transform: none;
  }

  .xp-bg {
    position: fixed;
    inset: 0;
    z-index: -2;
    background: var(--bg);
  }

  /*
   * The page under the paper is the same colour, so nothing else can show if the fixed paper is a
   * frame late during a fast scroll. `html body` outranks the site's own `body` colour (warmer, and
   * painted over the fixed paper) whichever stylesheet comes first. These styles only load on the
   * interactive version's pages.
   */
  :global(html),
  :global(html body) {
    background: #f0f0ed;
  }

  .fx {
    position: absolute;
    width: 0;
    height: 0;
    overflow: hidden;
  }

  .progress,
  .camera,
  .script,
  .draw-wrap,
  .route,
  .dots,
  .end-mark {
    display: none;
  }

  .hud {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--s-4);
    max-width: calc(var(--measure) + 2 * var(--side));
    margin: 0 auto;
    padding: var(--s-6) var(--side);
    font-size: 0.95rem;
  }

  .hud nav {
    display: flex;
    gap: var(--s-4);
  }

  .hud a {
    opacity: 0.55;
  }

  .hud a[aria-current] {
    opacity: 1;
  }

  .hud .hud-name {
    color: var(--ink);
    opacity: 1;
  }

  .scene {
    max-width: calc(var(--measure) + 2 * var(--side));
    margin: 0 auto;
    padding: var(--s-12) var(--side);
  }

  .logo {
    color: var(--ink);
    font-size: 2.25rem;
    font-weight: 600;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .o-pen,
  .o-photo {
    margin-top: var(--s-6);
  }

  .o-photo {
    width: min(18rem, 70%);
  }

  /* Letters.astro's and phrase.ts's spans, which scoped styles reach only through :global. */
  .xp :global(.wd) {
    white-space: nowrap;
  }

  .label {
    margin-bottom: var(--s-3);
    font-size: 0.95rem;
    font-weight: 400;
    opacity: 0.6;
  }

  h3 {
    margin: 0;
    font-size: 1.6rem;
    font-weight: 400;
  }

  .plain p + p,
  .t-text p + p {
    margin-top: var(--s-3);
  }

  .plain p + .label {
    margin-top: var(--s-12);
  }

  .visual {
    margin-top: var(--s-8);
  }

  .pairs,
  .t-prints,
  .eigen .v-in {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-4);
  }

  .pairs {
    margin-top: var(--s-8);
  }

  .pairs .phr,
  .pairs .label {
    display: none;
  }

  .t-prints {
    margin-top: var(--s-8);
  }

  .topic {
    margin-top: var(--s-12);
  }

  .t-text .detail {
    opacity: 0.7;
  }

  /* The phone's picture panels, only on the staged page. */
  .shot {
    display: none;
  }

  .xp p :global(a),
  .top-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
    text-underline-offset: 0.16em;
  }

  .contact-line {
    font-size: 1.6rem;
  }

  .end-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2) var(--s-6);
    margin-top: var(--s-6);
  }

  .pending {
    color: var(--muted);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    margin-top: var(--s-16);
    padding-top: var(--s-6);
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
    opacity: 0.75;
  }

  .machines {
    color: var(--bg);
  }

  /* ---------- The staged version ---------- */

  @media (prefers-reduced-motion: no-preference) {
    :global(.js) .xp {
      --stage: 100svh;
      /* The opening print's width; the camera and the note either side are placed against it. */
      --pw: clamp(13rem, 21vw, 19rem);
      /* When the note starts being written, and how long each letter takes. */
      --w0: 0.95s;
      --per: 13ms;
      /*
       * The phrases: their size, the space above the first one in a scene (so it sits mid-screen
       * when the scene settles), between phrases, and after the last one.
       */
      --phr-size: clamp(1.6rem, 2.35vw, 2.65rem);
      --p-top: 26svh;
      --phr-gap: 18svh;
      --p-bottom: 14svh;
      /* Medicine: a print's width, the space above the first pair, and between pairs. */
      --med-w: clamp(18rem, 28vw, 30rem);
      --pairs-top: 12svh;
      --pair-gap: 14svh;
      /* Personal: the space between one interest and the next. */
      --topic-gap: 22svh;
      /* How much bigger the big words are. */
      --big: 1.6;
      font-size: clamp(1.1rem, 1.5vw, 1.45rem);
    }

    :global(.js) .hud,
    :global(.js) .progress {
      position: fixed;
      z-index: 40;
    }

    :global(.js) .hud {
      inset: 0 0 auto;
      max-width: none;
      pointer-events: none;
    }

    :global(.js) .hud a {
      pointer-events: auto;
    }

    :global(.js) .progress {
      display: block;
      inset: 0 0 auto;
      height: 2px;
      background: var(--pen);
      transform: scaleX(0);
      transform-origin: 0 50%;
    }

    :global(.js) .scene {
      position: relative;
      max-width: none;
      padding: 0;
    }

    :global(.js) .stage {
      position: relative;
      height: var(--stage);
    }

    /* ----- Scenes with a picture and phrases: the picture stays, the phrases scroll past it ----- */

    :global(.js) .plain {
      display: none;
    }

    /* The picture stays on screen while its phrases pass, then leaves with the page as the next arrives. */
    :global(.js) .visual {
      position: sticky;
      top: 0;
      z-index: 1;
      height: var(--stage);
      margin: 0;
    }

    :global(.js) .v-in {
      position: absolute;
      inset: 0;
    }

    /* Pulled up over the picture, so the phrases start at the top of the scene. */
    :global(.js) .script {
      display: block;
      position: relative;
      z-index: 2;
      width: min(44rem, 46vw);
      margin: calc(-1 * var(--stage)) 0 0 var(--side);
      padding: var(--p-top) 0 var(--p-bottom);
      pointer-events: none;
    }

    :global(.js) .script a {
      pointer-events: auto;
    }

    :global(.js) .phr {
      margin: 0 0 var(--phr-gap);
      font-size: var(--phr-size);
      line-height: 1.18;
    }

    :global(.js) .phr-in {
      display: block;
      margin: 0;
    }

    /* A phrase with a pause after it, and one that belongs with the phrase after it. */
    :global(.js) .phr[data-space='more'] {
      margin-bottom: calc(var(--phr-gap) * 2.2);
    }

    :global(.js) .phr[data-space='less'] {
      margin-bottom: calc(var(--phr-gap) * 0.25);
    }

    :global(.js) .phr[data-at='i'] {
      padding-left: 12%;
    }

    :global(.js) .phr[data-at='r'] {
      text-align: right;
    }

    /* The scene's name, small, above its first phrase. A colour, not opacity: the script fades it. */
    :global(.js) .script .label,
    :global(.js) .pairs .label {
      margin-bottom: var(--s-6);
      font-size: 1.05rem;
      line-height: 1.32;
      color: rgb(47 51 148 / 0.6);
      opacity: 1;
    }

    /* The overlay markup (phrase.ts): lines, big words, small connecting words, and pen underlines. */
    :global(.js) .xp :global(.ln) {
      display: block;
      text-wrap: balance;
