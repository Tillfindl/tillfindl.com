---
// One text card: a title with its date, a detail line, short lines under it, a link if it has
// one, and room (the slot) for anything else the card needs.
import { text, type Card, type Lang } from '../content/profile';

interface Props {
  lang: Lang;
  card: Card;
  /** Extra classes, usually the card's width in the grid. */
  class?: string;
}

const { lang, card: c, class: extra } = Astro.props;
const Tag = c.url ? 'a' : 'div';
// Dates are written in English ("2024 – now"); only the open end needs translating.
const date = lang === 'de' ? c.date.replace('now', 'heute') : c.date;
---

<Tag class:list={['card', 'info', extra]} href={c.url} rel={c.url ? 'noopener' : undefined}>
  <div class="top">
    <h3>
      {text(c.title, lang)}
      {c.url && <span class="arrow" aria-hidden="true">↗</span>}
    </h3>
    {date && <span class="date">{date}</span>}
  </div>
  {c.detail[lang] && <p class="detail">{c.detail[lang]}</p>}
  {
    c.lines && (
      <div class="lines">
        {c.lines.map((l) => (
          <p>{l[lang]}</p>
        ))}
      </div>
    )
  }
  <slot />
</Tag>

<style>
  .info {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  h3 {
    font-size: var(--text-card);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .arrow {
    margin-left: 0.3em;
    color: var(--muted);
    font-weight: 400;
    transition: color 0.2s;
  }

  a:hover .arrow {
    color: var(--ink);
  }

  .date,
  .detail {
    color: var(--muted);
    font-size: var(--text-sm);
  }

  .date {
    white-space: nowrap;
  }

  .lines {
    display: grid;
    gap: 0.4rem;
    margin-top: 0.75rem;
    color: var(--body);
  }
</style>
